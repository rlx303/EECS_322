define int64 :main(){
	:entry
		return 5
		}

		define int64 :encode(int64 %p) {
			:entry1
				int64 %ret
					%ret <- %p << 1
						%ret <- %ret + 1
							return %ret 
							}

							define int64 :decode(int64 %p) {
								:entry2
									int64 %ret
										%ret <- %p - 1
											%ret <- %ret >> 1
												return %ret 
												}
