   %arg <- 2
   %odd_ret <- call :odd_num (%arg)
   %r1116 <- 5
   %and_by <- 9
   %sub_by <- 11
   %odd_ret <- %odd_ret - r1116
   %odd_ret <- %odd_ret + 1
   %odd_ret <- %odd_re + %r1116
   %shift_by <- 7
   %odd_ret <- %odd_ret << %shift_by
   %odd_ret <- %odd_ret & %and_by
   %odd_ret <- %odd_ret - %sub_by
   %odd_ret <- %odd_ret + 3
   %odd_ret <- %odd_ret << 1
