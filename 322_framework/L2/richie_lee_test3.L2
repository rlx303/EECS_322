define :main(){
  %first <- 10
  %second <- 9
  %ret <- call :max (%first, %second)
  %ret <- %ret << 1
  %ret <- %ret + 1
  call print (%ret)
  %first <- 10
  %second <- 3
  %ret <- call :divide (%first, %second)
  %ret <- %ret << 1
  %ret <- %ret + 1
  call print (%ret)
  return
  }

define :max(%first, %second){
  %comp <- %second < %first
  br %comp :FIRST
  %ret <- %second
  return %ret
  :FIRST
  %ret <- %first
  return %ret
 }

define :divide(%first, %second){
  %quotient <- 0
  :START
  %first <- %first - %second
  %comp <- %first < 0
  br %comp :DONE
  %quotient <- %quotient + 1
  br :START
  :DONE
  return %quotient
  }


