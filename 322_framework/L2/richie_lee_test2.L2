define :main(){
   %first <- 10
   %second <- 2
   %ret <- call :easy_divisible (%first, %second)
   %ret <- %ret << 1
   %ret <- %ret + 1
   call print (%ret)
   %first <- 10
   %second <- 3
   %ret <- call :easy_divisible (%first, %second)
   %ret <- %ret << 1
   %ret <- %ret + 1
   call print (%ret)
   return
  }
  
define :easy_divisible(%first, %second) {
  %ret <- 1
  :START
  %com <- %first = 0
  br %com :DONE
  %first <- %first - %second
  %com <- %first < 0
  br %com :NOO
  br :START
  :NOO
  %ret <- 0
  :DONE
  return %ret
}


