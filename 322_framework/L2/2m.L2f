(:populate
  1 7
    %array_positionWoShi0 <- rsp
    mem rsp 40 <- %array_positionWoShi0
    rsi <- 0
    :allocate_array
    %defaultWoShi0 <- rsi
    mem rsp 48 <- %defaultWoShi0
    %defaultWoShi1 <- mem rsp 48
    %encoded_default <- %defaultWoShi1
    %encoded_default <<= 1
    %encoded_default += 1
    rsi <- %encoded_default
    r14 <- rdi
    call allocate 2
    %array_positionWoShi1 <- mem rsp 40
    r12 <- %array_positionWoShi1
    mem r12 0 <- rax
    rdi <- r14
    r14 >>= 1
    %defaultWoShi2 <- mem rsp 48
    rsi <- %defaultWoShi2
    rsi += 1
    %array_positionWoShi2 <- mem rsp 40
    %array_positionWoShi2 += 8
    mem rsp 40 <- %array_positionWoShi2
    goto :bound_check
    :bound_check
    cjump rsi < r14 :allocate_array :wrap
    :wrap
    %size <- rdi
    call allocate 2
    rdi <- %size
    rdi >>= 1
    %outer_header <- rax
    %inner_ptr <- rax
    :populate_outer_array
    %array_positionWoShi3 <- mem rsp 40
    %array_positionWoShi3 -= 8
    mem rsp 40 <- %array_positionWoShi3
    %inner_ptr += 8
    %array_positionWoShi4 <- mem rsp 40
    r12 <- %array_positionWoShi4
    %ptr_array_posn <- mem r12 0
    rax <- %inner_ptr
    mem rax 0 <- %ptr_array_posn
    rdi -= 1
    goto :outer_bound_check
    :outer_bound_check
    cjump 0 <= rdi :populate_outer_array :print_array
    :print_array
    rdi <- %outer_header
    call print 1
    return
)
